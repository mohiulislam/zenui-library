{
  "name": "ZenUI Library",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Quickly browse and search ZenUI components without ever leaving your browser.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "ZenUI Components"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://zenui.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "components-data.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
